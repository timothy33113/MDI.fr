# Configuration du serveur
NODE_ENV=development
PORT=3002

# Base de données PostgreSQL
DATABASE_URL=postgresql://timothy@localhost:5432/mdi_db

# JWT Secret
JWT_SECRET=mdi-dev-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-3
AWS_S3_BUCKET=mdi-files

# Configuration CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# OpenRouter API (pour l'analyse des annonces Leboncoin avec Claude 3.5)
OPENROUTER_API_KEY=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 